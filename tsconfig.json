{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Prompt templates are imported as strings from `src/prompts/*.md`; esbuild
    // inlines them (`--loader:.md=text`) and the sibling `*.d.md.ts` files type
    // them.
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out"]
}
