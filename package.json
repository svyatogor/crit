{
  "name": "crit",
  "displayName": "Crit",
  "description": "Crit \u2014 pair review with your AI. Inline code review comments \u2014 review AI-generated changes, submit feedback in batch to Copilot, Claude Code, or any AI agent, with git diff context",
  "version": "0.4.0",
  "publisher": "Sergey Kuleshov",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/svyatogor/crit"
  },
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=22.18"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "code review",
    "comments",
    "copilot",
    "diff",
    "inline-comments",
    "claude",
    "mcp",
    "agent",
    "review",
    "git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Crit",
      "properties": {
        "crit.aiProvider": {
          "type": "string",
          "enum": [
            "copilot",
            "claudeCode"
          ],
          "enumItemLabels": [
            "GitHub Copilot",
            "Claude Code"
          ],
          "default": "copilot",
          "scope": "window",
          "description": "AI provider used by Crit's Send to AI actions."
        },
        "crit.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `claude` CLI. Leave empty to find it on PATH \u2014 only needed when Crit cannot locate it, e.g. when VS Code failed to resolve your shell environment."
        }
      }
    },
    "commands": [
      {
        "command": "crit.createNote",
        "title": "Add Comment",
        "icon": "$(check)"
      },
      {
        "command": "crit.reply",
        "title": "Reply",
        "icon": "$(reply)"
      },
      {
        "command": "crit.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "crit.saveEdit",
        "title": "Save",
        "icon": "$(check)"
      },
      {
        "command": "crit.cancelEdit",
        "title": "Cancel",
        "icon": "$(close)"
      },
      {
        "command": "crit.deleteNote",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "crit.sendThread",
        "title": "Send to AI",
        "icon": "$(send)"
      },
      {
        "command": "crit.resolve",
        "title": "Resolve",
        "icon": "$(check-all)"
      },
      {
        "command": "crit.unresolve",
        "title": "Reopen",
        "icon": "$(debug-restart)"
      },
      {
        "command": "crit.showPanel",
        "title": "Crit: Show Comments Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "crit.submitAll",
        "title": "Crit: Send All to AI",
        "icon": "$(send)"
      },
      {
        "command": "crit.resolveAll",
        "title": "Crit: Resolve All",
        "icon": "$(check-all)"
      },
      {
        "command": "crit.deleteResolved",
        "title": "Crit: Delete All Resolved",
        "icon": "$(trash)"
      },
      {
        "command": "crit.clearAll",
        "title": "Crit: Clear All Comments",
        "icon": "$(clear-all)"
      },
      {
        "command": "crit.copyThread",
        "title": "Copy to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "crit.copyAll",
        "title": "Crit: Copy All to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "crit.requestReview",
        "title": "Crit: Ask Claude to Review Changes",
        "icon": "$(sparkle)"
      },
      {
        "command": "crit.requestReviewFile",
        "title": "Crit: Ask Claude to Review This File",
        "icon": "$(sparkle)"
      },
      {
        "command": "crit.installMcpServer",
        "title": "Crit: Install MCP Server for Claude Code",
        "icon": "$(plug)"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "crit.createNote",
          "group": "inline",
          "when": "commentController == crit && commentThreadIsEmpty"
        },
        {
          "command": "crit.reply",
          "group": "inline",
          "when": "commentController == crit && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "crit.editComment",
          "group": "inline@1",
          "when": "commentController == crit && comment == userComment"
        },
        {
          "command": "crit.deleteNote",
          "group": "inline@2",
          "when": "commentController == crit"
        }
      ],
      "comments/comment/context": [
        {
          "command": "crit.saveEdit",
          "group": "inline@1",
          "when": "commentController == crit"
        },
        {
          "command": "crit.cancelEdit",
          "group": "inline@2",
          "when": "commentController == crit"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "crit.sendThread",
          "group": "inline@1",
          "when": "commentController == crit && !commentThreadIsEmpty"
        },
        {
          "command": "crit.copyThread",
          "group": "inline@2",
          "when": "commentController == crit && !commentThreadIsEmpty"
        },
        {
          "command": "crit.resolve",
          "group": "inline@2",
          "when": "commentController == crit && commentThread == open"
        },
        {
          "command": "crit.unresolve",
          "group": "inline@2",
          "when": "commentController == crit && commentThread == resolved"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "crit_listComments",
        "displayName": "List Crit Comments",
        "toolReferenceName": "listDiffComments",
        "icon": "$(comment)",
        "modelDescription": "Lists all inline review comments with their threadRef, file locations, status (open/resolved), and full thread text including user and agent replies. Use this to see what review feedback exists and to get the threadRef needed by the other Crit tools.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "crit_replyToComment",
        "displayName": "Reply to Crit Comment",
        "toolReferenceName": "replyToDiffComment",
        "icon": "$(reply)",
        "modelDescription": "Reply to an existing inline review comment thread. Use this to respond to user feedback on code changes, explain your reasoning, or acknowledge a requested change. The reply appears as an agent message in the comment thread.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadRef": {
              "type": "string",
              "description": "The threadRef of the comment thread to reply to (from the listComments output)"
            },
            "text": {
              "type": "string",
              "description": "The reply text to add to the thread"
            }
          },
          "required": [
            "threadRef",
            "text"
          ]
        }
      },
      {
        "name": "crit_resolveComment",
        "displayName": "Resolve Crit Comment",
        "toolReferenceName": "resolveDiffComment",
        "icon": "$(check)",
        "modelDescription": "Mark an inline review comment as resolved/done. Use this after you have addressed the feedback in the comment \u2014 e.g., after making the requested code change.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadRef": {
              "type": "string",
              "description": "The threadRef of the comment thread to resolve (from the listComments output)"
            }
          },
          "required": [
            "threadRef"
          ]
        }
      },
      {
        "name": "crit_deleteComment",
        "displayName": "Delete Crit Comment",
        "toolReferenceName": "deleteDiffComment",
        "icon": "$(trash)",
        "modelDescription": "Delete an inline review comment thread entirely. Use this only when explicitly asked to remove a comment.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadRef": {
              "type": "string",
              "description": "The threadRef of the comment thread to delete (from the listComments output)"
            }
          },
          "required": [
            "threadRef"
          ]
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./",
    "test": "npm run typecheck && npm run build:mcp && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.cjs",
    "build": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --loader:.md=text && npx esbuild src/mcp-server.ts --bundle --outfile=out/mcp-server.js --format=cjs --platform=node --target=node18",
    "build:ext": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --loader:.md=text",
    "build:mcp": "npx esbuild src/mcp-server.ts --bundle --outfile=out/mcp-server.js --format=cjs --platform=node --target=node18",
    "package": "echo y | npx vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "which": "^7.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.93.0",
    "@types/which": "^3.0.4",
    "esbuild": "^0.20.0",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0"
  }
}
