{
  "name": "crit",
  "displayName": "Crit",
  "description": "Crit — pair review with your AI. Inline code review comments — review AI-generated changes, submit feedback in batch to Copilot, Claude Code, or any AI agent, with git diff context",
  "version": "0.3.0",
  "publisher": "Sergey Kuleshov",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinqishen0725/diff-review"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "code review",
    "comments",
    "copilot",
    "diff",
    "inline-comments",
    "claude",
    "mcp",
    "agent",
    "review",
    "git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Crit",
      "properties": {
        "crit.aiProvider": {
          "type": "string",
          "enum": [
            "copilot",
            "claudeCode"
          ],
          "enumItemLabels": [
            "GitHub Copilot",
            "Claude Code"
          ],
          "default": "copilot",
          "scope": "window",
          "description": "AI provider used by Crit's Send to AI actions."
        }
      }
    },
    "commands": [
      {
        "command": "crit.createNote",
        "title": "Add Comment",
        "icon": "$(check)"
      },
      {
        "command": "crit.reply",
        "title": "Reply",
        "icon": "$(reply)"
      },
      {
        "command": "crit.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "crit.saveEdit",
        "title": "Save",
        "icon": "$(check)"
      },
      {
        "command": "crit.cancelEdit",
        "title": "Cancel",
        "icon": "$(close)"
      },
      {
        "command": "crit.deleteNote",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "crit.sendThread",
        "title": "Send to AI",
        "icon": "$(send)"
      },
      {
        "command": "crit.resolve",
        "title": "Resolve",
        "icon": "$(check-all)"
      },
      {
        "command": "crit.unresolve",
        "title": "Reopen",
        "icon": "$(debug-restart)"
      },
      {
        "command": "crit.showPanel",
        "title": "Crit: Show Comments Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "crit.submitAll",
        "title": "Crit: Send All to AI",
        "icon": "$(send)"
      },
      {
        "command": "crit.resolveAll",
        "title": "Crit: Resolve All",
        "icon": "$(check-all)"
      },
      {
        "command": "crit.deleteResolved",
        "title": "Crit: Delete All Resolved",
        "icon": "$(trash)"
      },
      {
        "command": "crit.clearAll",
        "title": "Crit: Clear All Comments",
        "icon": "$(clear-all)"
      },
      {
        "command": "crit.copyThread",
        "title": "Copy to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "crit.copyAll",
        "title": "Crit: Copy All to Clipboard",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "crit.createNote",
          "group": "inline",
          "when": "commentController == crit && commentThreadIsEmpty"
        },
        {
          "command": "crit.reply",
          "group": "inline",
          "when": "commentController == crit && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "crit.editComment",
          "group": "inline@1",
          "when": "commentController == crit && comment == userComment"
        },
        {
          "command": "crit.deleteNote",
          "group": "inline@2",
          "when": "commentController == crit"
        }
      ],
      "comments/comment/context": [
        {
          "command": "crit.saveEdit",
          "group": "inline@1",
          "when": "commentController == crit"
        },
        {
          "command": "crit.cancelEdit",
          "group": "inline@2",
          "when": "commentController == crit"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "crit.sendThread",
          "group": "inline@1",
          "when": "commentController == crit && !commentThreadIsEmpty"
        },
        {
          "command": "crit.copyThread",
          "group": "inline@2",
          "when": "commentController == crit && !commentThreadIsEmpty"
        },
        {
          "command": "crit.resolve",
          "group": "inline@2",
          "when": "commentController == crit && commentThread == open"
        },
        {
          "command": "crit.unresolve",
          "group": "inline@2",
          "when": "commentController == crit && commentThread == resolved"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "crit_listComments",
        "displayName": "List Crit Comments",
        "toolReferenceName": "listDiffComments",
        "icon": "$(comment)",
        "modelDescription": "Lists all inline review comments with their IDs, file locations, status (open/resolved), and full thread text including user and agent replies. Use this to see what review feedback exists.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "crit_replyToComment",
        "displayName": "Reply to Crit Comment",
        "toolReferenceName": "replyToDiffComment",
        "icon": "$(reply)",
        "modelDescription": "Reply to an existing inline review comment thread. Use this to respond to user feedback on code changes, explain your reasoning, or acknowledge a requested change. The reply appears as an agent message in the comment thread.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "commentId": {
              "type": "number",
              "description": "The ID number of the comment thread to reply to (from listComments output, e.g. #1, #2)"
            },
            "text": {
              "type": "string",
              "description": "The reply text to add to the thread"
            }
          },
          "required": [
            "commentId",
            "text"
          ]
        }
      },
      {
        "name": "crit_resolveComment",
        "displayName": "Resolve Crit Comment",
        "toolReferenceName": "resolveDiffComment",
        "icon": "$(check)",
        "modelDescription": "Mark an inline review comment as resolved/done. Use this after you have addressed the feedback in the comment — e.g., after making the requested code change.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "commentId": {
              "type": "number",
              "description": "The ID number of the comment thread to resolve"
            }
          },
          "required": [
            "commentId"
          ]
        }
      },
      {
        "name": "crit_deleteComment",
        "displayName": "Delete Crit Comment",
        "toolReferenceName": "deleteDiffComment",
        "icon": "$(trash)",
        "modelDescription": "Delete an inline review comment thread entirely. Use this only when explicitly asked to remove a comment.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "commentId": {
              "type": "number",
              "description": "The ID number of the comment thread to delete"
            }
          },
          "required": [
            "commentId"
          ]
        }
      }
    ]
  },
  "scripts": {
    "test": "npm run compile && node --test tests/*.test.cjs",
    "compile": "tsc -p ./",
    "build": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode && npx esbuild src/mcp-server.ts --bundle --outfile=out/mcp-server.js --format=cjs --platform=node --target=node18",
    "build:ext": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode",
    "build:mcp": "npx esbuild src/mcp-server.ts --bundle --outfile=out/mcp-server.js --format=cjs --platform=node --target=node18",
    "package": "echo y | npx vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.20.0",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0"
  }
}
