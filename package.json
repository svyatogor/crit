{
  "name": "crit",
  "displayName": "Crit",
  "description": "Crit — pair review with your AI. Inline code review comments — review AI-generated changes, submit feedback in batch to Copilot, Claude Code, or any AI agent, with git diff context",
  "version": "0.5.1",
  "publisher": "svyatogor",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/svyatogor/crit"
  },
  "engines": {
    "vscode": "^1.110.0",
    "node": ">=22.18"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "code review",
    "comments",
    "copilot",
    "diff",
    "inline-comments",
    "claude",
    "mcp",
    "agent",
    "review",
    "git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Crit",
      "properties": {
        "crit.aiProvider": {
          "type": "string",
          "enum": [
            "copilot",
            "claudeCode"
          ],
          "enumItemLabels": [
            "GitHub Copilot",
            "Claude Code"
          ],
          "default": "copilot",
          "scope": "window",
          "description": "AI provider used by Crit's Send to AI actions."
        },
        "crit.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to the `claude` CLI. Leave empty to find it on PATH — only needed when Crit cannot locate it, e.g. when VS Code failed to resolve your shell environment."
        }
      }
    },
    "commands": [
      {
        "command": "crit.createNote",
        "title": "Add Comment",
        "icon": "$(check)",
        "category": "Crit"
      },
      {
        "command": "crit.reply",
        "title": "Reply",
        "icon": "$(reply)",
        "category": "Crit"
      },
      {
        "command": "crit.editComment",
        "title": "Edit",
        "icon": "$(edit)",
        "category": "Crit"
      },
      {
        "command": "crit.saveEdit",
        "title": "Save",
        "icon": "$(check)",
        "category": "Crit"
      },
      {
        "command": "crit.cancelEdit",
        "title": "Cancel",
        "icon": "$(close)",
        "category": "Crit"
      },
      {
        "command": "crit.deleteNote",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Crit"
      },
      {
        "command": "crit.sendThread",
        "title": "Send to AI",
        "icon": "$(send)",
        "category": "Crit"
      },
      {
        "command": "crit.resolve",
        "title": "Resolve",
        "icon": "$(check-all)",
        "category": "Crit"
      },
      {
        "command": "crit.unresolve",
        "title": "Reopen",
        "icon": "$(debug-restart)",
        "category": "Crit"
      },
      {
        "command": "crit.submitAll",
        "title": "Send All to AI",
        "icon": "$(send)",
        "category": "Crit"
      },
      {
        "command": "crit.resolveAll",
        "title": "Resolve All",
        "icon": "$(check-all)",
        "category": "Crit"
      },
      {
        "command": "crit.deleteResolved",
        "title": "Delete All Resolved",
        "icon": "$(trash)",
        "category": "Crit"
      },
      {
        "command": "crit.clearAll",
        "title": "Clear All Comments",
        "icon": "$(clear-all)",
        "category": "Crit"
      },
      {
        "command": "crit.copyThread",
        "title": "Copy to Clipboard",
        "icon": "$(clippy)",
        "category": "Crit"
      },
      {
        "command": "crit.copyAll",
        "title": "Copy All to Clipboard",
        "icon": "$(clippy)",
        "category": "Crit"
      },
      {
        "command": "crit.requestReview",
        "title": "Ask Claude to Review Changes",
        "icon": "$(sparkle)",
        "category": "Crit"
      },
      {
        "command": "crit.requestReviewFile",
        "title": "Ask Claude to Review This File",
        "icon": "$(sparkle)",
        "category": "Crit"
      },
      {
        "command": "crit.installMcpServer",
        "title": "Install MCP Server for Claude Code",
        "icon": "$(plug)",
        "category": "Crit"
      },
      {
        "command": "crit.submitFile",
        "title": "Send File's Comments to AI",
        "icon": "$(send)",
        "category": "Crit"
      },
      {
        "command": "crit.copyFile",
        "title": "Copy File's Comments to Clipboard",
        "icon": "$(clippy)",
        "category": "Crit"
      },
      {
        "command": "crit.resolveFile",
        "title": "Resolve All Comments in File",
        "icon": "$(check-all)",
        "category": "Crit"
      },
      {
        "command": "crit.deleteResolvedFile",
        "title": "Delete Resolved Comments in File",
        "icon": "$(trash)",
        "category": "Crit"
      },
      {
        "command": "crit.openChange",
        "title": "Open Changes",
        "category": "Crit"
      },
      {
        "command": "crit.markReviewed",
        "title": "Mark as Reviewed",
        "icon": "$(check)",
        "category": "Crit"
      },
      {
        "command": "crit.unmarkReviewed",
        "title": "Mark as Not Reviewed",
        "icon": "$(circle-large-outline)",
        "category": "Crit"
      },
      {
        "command": "crit.showChangesSinceReviewed",
        "title": "Show Changes Since I Reviewed",
        "icon": "$(diff)",
        "category": "Crit"
      },
      {
        "command": "crit.markAllReviewed",
        "title": "Mark All Files Reviewed",
        "icon": "$(check-all)",
        "category": "Crit"
      },
      {
        "command": "crit.clearReviewed",
        "title": "Clear All Reviewed Marks",
        "icon": "$(clear-all)",
        "category": "Crit"
      },
      {
        "command": "crit.refreshChanges",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Crit"
      },
      {
        "command": "crit.changesAsTree",
        "title": "View as Tree",
        "icon": "$(list-tree)",
        "category": "Crit"
      },
      {
        "command": "crit.changesAsList",
        "title": "View as List",
        "icon": "$(list-flat)",
        "category": "Crit"
      },
      {
        "command": "crit.goToThread",
        "title": "Go to Comment",
        "category": "Crit"
      },
      {
        "command": "crit.deleteThread",
        "title": "Delete Comment Thread",
        "icon": "$(trash)",
        "category": "Crit"
      },
      {
        "command": "crit.filterComments",
        "title": "Filter Comments",
        "icon": "$(filter)",
        "category": "Crit"
      },
      {
        "command": "crit.clearCommentsFilter",
        "title": "Clear Comment Filter",
        "icon": "$(filter-filled)",
        "category": "Crit"
      },
      {
        "command": "crit.hideResolvedComments",
        "title": "Hide Resolved Comments",
        "icon": "$(eye)",
        "category": "Crit"
      },
      {
        "command": "crit.showResolvedComments",
        "title": "Show Resolved Comments",
        "icon": "$(eye-closed)",
        "category": "Crit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crit",
          "title": "Crit",
          "icon": "media/crit.svg"
        }
      ]
    },
    "views": {
      "crit": [
        {
          "id": "crit.changes",
          "name": "Changes",
          "contextualTitle": "Crit"
        },
        {
          "id": "crit.comments",
          "name": "Comments",
          "contextualTitle": "Crit"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "crit.changes",
        "contents": "No changes against HEAD.\n\nOnce you or an agent edits something, the files show up here and you can tick them off as you review them.\n[Ask AI to Review Changes](command:crit.requestReview)"
      },
      {
        "view": "crit.comments",
        "contents": "No review comments yet.\n\nHover a line gutter in any file and click the + to leave one, or have the AI review the change and comment first.\n[Ask AI to Review Changes](command:crit.requestReview)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "crit.submitFile",
          "when": "false"
        },
        {
          "command": "crit.copyFile",
          "when": "false"
        },
        {
          "command": "crit.resolveFile",
          "when": "false"
        },
        {
          "command": "crit.deleteResolvedFile",
          "when": "false"
        },
        {
          "command": "crit.openChange",
          "when": "false"
        },
        {
          "command": "crit.markReviewed",
          "when": "false"
        },
        {
          "command": "crit.unmarkReviewed",
          "when": "false"
        },
        {
          "command": "crit.showChangesSinceReviewed",
          "when": "false"
        },
        {
          "command": "crit.refreshChanges",
          "when": "false"
        },
        {
          "command": "crit.changesAsTree",
          "when": "false"
        },
        {
          "command": "crit.changesAsList",
          "when": "false"
        },
        {
          "command": "crit.goToThread",
          "when": "false"
        },
        {
          "command": "crit.deleteThread",
          "when": "false"
        },
        {
          "command": "crit.hideResolvedComments",
          "when": "false"
        },
        {
          "command": "crit.showResolvedComments",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "crit.requestReview",
          "when": "view == crit.changes",
          "group": "navigation@1"
        },
        {
          "command": "crit.markAllReviewed",
          "when": "view == crit.changes",
          "group": "navigation@2"
        },
        {
          "command": "crit.changesAsTree",
          "when": "view == crit.changes && !crit.changesAsTree",
          "group": "navigation@3"
        },
        {
          "command": "crit.changesAsList",
          "when": "view == crit.changes && crit.changesAsTree",
          "group": "navigation@3"
        },
        {
          "command": "crit.refreshChanges",
          "when": "view == crit.changes",
          "group": "navigation@4"
        },
        {
          "command": "crit.clearReviewed",
          "when": "view == crit.changes",
          "group": "1_crit"
        },
        {
          "command": "crit.submitAll",
          "when": "view == crit.comments",
          "group": "navigation@1"
        },
        {
          "command": "crit.copyAll",
          "when": "view == crit.comments",
          "group": "navigation@2"
        },
        {
          "command": "crit.filterComments",
          "when": "view == crit.comments && !crit.commentsFiltered",
          "group": "navigation@3"
        },
        {
          "command": "crit.clearCommentsFilter",
          "when": "view == crit.comments && crit.commentsFiltered",
          "group": "navigation@3"
        },
        {
          "command": "crit.hideResolvedComments",
          "when": "view == crit.comments && !crit.hidingResolved",
          "group": "navigation@4"
        },
        {
          "command": "crit.showResolvedComments",
          "when": "view == crit.comments && crit.hidingResolved",
          "group": "navigation@4"
        },
        {
          "command": "crit.resolveAll",
          "when": "view == crit.comments",
          "group": "1_crit@1"
        },
        {
          "command": "crit.deleteResolved",
          "when": "view == crit.comments",
          "group": "1_crit@2"
        },
        {
          "command": "crit.clearAll",
          "when": "view == crit.comments",
          "group": "1_crit@3"
        }
      ],
      "view/item/context": [
        {
          "command": "crit.showChangesSinceReviewed",
          "when": "view == crit.changes && viewItem == critChange.stale",
          "group": "inline@1"
        },
        {
          "command": "crit.markReviewed",
          "when": "view == crit.changes && viewItem == critChange.stale",
          "group": "inline@2"
        },
        {
          "command": "crit.requestReviewFile",
          "when": "view == crit.changes && viewItem =~ /^critChange\\./",
          "group": "inline@3"
        },
        {
          "command": "crit.openChange",
          "when": "view == crit.changes && viewItem =~ /^critChange\\./",
          "group": "1_open"
        },
        {
          "command": "crit.markReviewed",
          "when": "view == crit.changes && (viewItem == critChange.unreviewed || viewItem == critChangeFolder)",
          "group": "2_review"
        },
        {
          "command": "crit.unmarkReviewed",
          "when": "view == crit.changes && viewItem != critChange.unreviewed",
          "group": "2_review"
        },
        {
          "command": "crit.sendThread",
          "when": "view == crit.comments && viewItem == critThread.open",
          "group": "inline@1"
        },
        {
          "command": "crit.resolve",
          "when": "view == crit.comments && viewItem == critThread.open",
          "group": "inline@2"
        },
        {
          "command": "crit.unresolve",
          "when": "view == crit.comments && viewItem == critThread.resolved",
          "group": "inline@2"
        },
        {
          "command": "crit.copyThread",
          "when": "view == crit.comments && viewItem =~ /^critThread/",
          "group": "1_crit"
        },
        {
          "command": "crit.deleteThread",
          "when": "view == crit.comments && viewItem =~ /^critThread/",
          "group": "2_crit"
        },
        {
          "command": "crit.submitFile",
          "when": "view == crit.comments && viewItem == critCommentFile",
          "group": "inline@1"
        },
        {
          "command": "crit.copyFile",
          "when": "view == crit.comments && viewItem == critCommentFile",
          "group": "1_crit"
        },
        {
          "command": "crit.resolveFile",
          "when": "view == crit.comments && viewItem == critCommentFile",
          "group": "1_crit"
        },
        {
          "command": "crit.deleteResolvedFile",
          "when": "view == crit.comments && viewItem == critCommentFile",
          "group": "2_crit"
        }
      ],
      "scm/title": [
        {
          "command": "crit.requestReview",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "crit.requestReviewFile",
          "group": "inline",
          "when": "scmProvider == git"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "crit.createNote",
          "group": "inline",
          "when": "commentController == crit && commentThreadIsEmpty"
        },
        {
          "command": "crit.reply",
          "group": "inline",
          "when": "commentController == crit && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "crit.editComment",
          "group": "inline@1",
          "when": "commentController == crit && comment == userComment"
        },
        {
          "command": "crit.deleteNote",
          "group": "inline@2",
          "when": "commentController == crit"
        }
      ],
      "comments/comment/context": [
        {
          "command": "crit.saveEdit",
          "group": "inline@1",
          "when": "commentController == crit"
        },
        {
          "command": "crit.cancelEdit",
          "group": "inline@2",
          "when": "commentController == crit"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "crit.sendThread",
          "group": "inline@1",
          "when": "commentController == crit && !commentThreadIsEmpty"
        },
        {
          "command": "crit.copyThread",
          "group": "inline@2",
          "when": "commentController == crit && !commentThreadIsEmpty"
        },
        {
          "command": "crit.resolve",
          "group": "inline@2",
          "when": "commentController == crit && commentThread == open"
        },
        {
          "command": "crit.unresolve",
          "group": "inline@2",
          "when": "commentController == crit && commentThread == resolved"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "crit_listComments",
        "displayName": "List Crit Comments",
        "toolReferenceName": "listDiffComments",
        "icon": "$(comment)",
        "modelDescription": "Lists all inline review comments with their threadRef, file locations, status (open/resolved), and full thread text including user and agent replies. Use this to see what review feedback exists and to get the threadRef needed by the other Crit tools.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "crit_replyToComment",
        "displayName": "Reply to Crit Comment",
        "toolReferenceName": "replyToDiffComment",
        "icon": "$(reply)",
        "modelDescription": "Reply to an existing inline review comment thread. Use this to respond to user feedback on code changes, explain your reasoning, or acknowledge a requested change. The reply appears as an agent message in the comment thread.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadRef": {
              "type": "string",
              "description": "The threadRef of the comment thread to reply to (from the listComments output)"
            },
            "text": {
              "type": "string",
              "description": "The reply text to add to the thread"
            }
          },
          "required": [
            "threadRef",
            "text"
          ]
        }
      },
      {
        "name": "crit_resolveComment",
        "displayName": "Resolve Crit Comment",
        "toolReferenceName": "resolveDiffComment",
        "icon": "$(check)",
        "modelDescription": "Mark an inline review comment as resolved/done. Use this after you have addressed the feedback in the comment — e.g., after making the requested code change.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadRef": {
              "type": "string",
              "description": "The threadRef of the comment thread to resolve (from the listComments output)"
            }
          },
          "required": [
            "threadRef"
          ]
        }
      },
      {
        "name": "crit_deleteComment",
        "displayName": "Delete Crit Comment",
        "toolReferenceName": "deleteDiffComment",
        "icon": "$(trash)",
        "modelDescription": "Delete an inline review comment thread entirely. Use this only when explicitly asked to remove a comment.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "threadRef": {
              "type": "string",
              "description": "The threadRef of the comment thread to delete (from the listComments output)"
            }
          },
          "required": [
            "threadRef"
          ]
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run lint && npm run format:check",
    "test": "npm run typecheck && npm run build:mcp && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.cjs",
    "build": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --loader:.md=text && npx esbuild src/mcp-server.ts --bundle --outfile=out/mcp-server.js --format=cjs --platform=node --target=node18",
    "build:ext": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --loader:.md=text",
    "build:mcp": "npx esbuild src/mcp-server.ts --bundle --outfile=out/mcp-server.js --format=cjs --platform=node --target=node18",
    "package": "echo y | npx vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@vscode/vsce": "^3.9.2",
    "es-toolkit": "^1.51.0",
    "which": "^7.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.93.0",
    "@types/which": "^3.0.4",
    "esbuild": "^0.20.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0"
  }
}
